# ─────────────────────────────────────────────────────────────
#  Webinar platform — PRODUCTION configuration
#
#  Copy to `.env` in the repo root, or let `./deploy.sh install` write it for
#  you with generated secrets. Every port below is configurable; change it here
#  and re-run `./deploy.sh up`.
#
#  After editing, run `./deploy.sh ports` to see exactly what to whitelist.
# ─────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────
NODE_ENV=production

# Public URL of the site. Used for CORS, cookies and email links.
# Must match what users type in the browser, including the scheme.
WEB_ORIGIN=https://webinar.example.com

# These are inlined into the browser bundle at BUILD time.
# Changing them requires `./deploy.sh rebuild`, not just a restart.
#
# Do NOT append /api. The client does fetch(`${API_URL}${path}`) and every path
# already begins with /api, so a suffix produces /api/api/... and 404s.
NEXT_PUBLIC_API_URL=https://webinar.example.com
NEXT_PUBLIC_SOCKET_URL=https://webinar.example.com

# ── Ports ────────────────────────────────────────────────────
# Public entry point (nginx).
#
# TLS IS NOT TERMINATED HERE. A Caddy instance on the VPS owns 80/443, obtains
# and renews the certificate, and forwards plain HTTP to this port:
#
#   internet ──443/TLS──> Caddy ──5173/HTTP──> nginx ──> web / api
#
# So nginx only ever speaks plain HTTP and needs no certificates. Point Caddy's
# reverse_proxy at 127.0.0.1:5173 and it handles SSL for you.
HTTP_PORT=5173
SERVER_NAME=webinar.example.com

# Internal services. Bound to loopback; nginx proxies to them.
API_PORT=4000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── WebRTC media (mediasoup) ─────────────────────────────────
# THIS IS THE CAPACITY KNOB.
#
# Each peer uses 2 transports (send + recv) and each transport takes 1 port,
# so the number of concurrent peers is (RTC_MAX_PORT - RTC_MIN_PORT + 1) / 2.
#
#   40000-40100  =  100 ports =  50 peers   (the old default — too small)
#   40000-42000  = 2000 ports = 1000 peers  (recommended for 500+)
#
# The range is shared by ALL mediasoup workers. Raising MEDIASOUP_WORKERS does
# not increase capacity — only widening this range does.
RTC_MIN_PORT=40000
RTC_MAX_PORT=42000

# Public IPv4 of this host. mediasoup advertises it in ICE candidates, so it
# must be reachable from the browser. `./deploy.sh install` fills this in.
PUBLIC_IP=203.0.113.10
MEDIASOUP_ANNOUNCED_IP=203.0.113.10

# Worker processes. One per CPU core is a reasonable ceiling. This affects
# throughput, not capacity.
MEDIASOUP_WORKERS=4

# ── TURN (coturn) ────────────────────────────────────────────
# Required for participants behind symmetric NAT or a corporate firewall.
# Without it those users simply cannot connect.
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_MIN_PORT=49152
TURN_MAX_PORT=65535
TURN_REALM=webinar.example.com
TURN_USERNAME=webinar
TURN_PASSWORD=change-me-turn-password

# Handed to the browser via GET /api/rtc-config.
TURN_URL=turn:203.0.113.10:3478

# ── Database ─────────────────────────────────────────────────
# The image rewrites the Prisma provider at build time. Leave as postgresql
# for production; set to sqlite only for a throwaway single-user instance.
DATABASE_PROVIDER=postgresql
POSTGRES_USER=webinar
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=webinar

# Applied by the container entrypoint on start. Set to 0 to manage the schema
# yourself (e.g. when running several API replicas).
RUN_MIGRATIONS=1

# ── Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48 | tr -d '\n=+/'
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@webinar.local
ADMIN_PASSWORD=change-me-admin-password

# ── Razorpay ─────────────────────────────────────────────────
# Leave blank to run in mock-payment mode. Set all three for real payments.
RZP_KEY_ID=
RZP_KEY_SECRET=
RZP_WEBHOOK_SECRET=
NEXT_PUBLIC_RZP_KEY_ID=

# ── Email (optional) ─────────────────────────────────────────
# Order of precedence: SMTP_HOST, then RESEND_API_KEY, then console logging.
RESEND_API_KEY=
EMAIL_FROM=webinars@example.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Reminders ────────────────────────────────────────────────
REMINDERS_ENABLED=true
