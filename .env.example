# ─────────────────────────────────────────────────────────────
#  Webinar Platform — environment configuration
#  Copy to .env and fill in real values.
# ─────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ── Database ─────────────────────────────────────────────────
# Local dev uses SQLite (zero setup). For production switch the
# provider in apps/server/prisma/schema.prisma to "postgresql" and use:
# DATABASE_URL=postgresql://webinar:webinar@localhost:5432/webinar?schema=public
DATABASE_URL="file:./dev.db"

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@webinar.local
ADMIN_PASSWORD=Admin@12345

# ── Razorpay ─────────────────────────────────────────────────
# Leave blank to run in "mock payments" mode (dev only).
RZP_KEY_ID=
RZP_KEY_SECRET=
RZP_WEBHOOK_SECRET=
NEXT_PUBLIC_RZP_KEY_ID=

# ── mediasoup / WebRTC ───────────────────────────────────────
# PUBLIC_IP must be the server's public IP in production.
PUBLIC_IP=127.0.0.1
RTC_MIN_PORT=40000
RTC_MAX_PORT=40100
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_WORKERS=2

# ── TURN (coturn) ────────────────────────────────────────────
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# ── Email (optional) ─────────────────────────────────────────
# Three transports, picked in this order:
#   1. SMTP_HOST set        -> plain SMTP (any provider)
#   2. RESEND_API_KEY set   -> Resend over SMTP
#   3. neither              -> messages are logged to the console
# Mail is always best-effort: a send failure never fails a registration
# or rolls back a payment.
RESEND_API_KEY=
EMAIL_FROM=webinars@example.com

# Optional SMTP. Wins over RESEND_API_KEY when both are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Reminders ────────────────────────────────────────────────
# Emails registrants 24h / 1h / 10m before a webinar starts.
# Set to "false" to disable the scheduler entirely.
REMINDERS_ENABLED=true
